{
  "name": "@exortek/remix-express",
  "version": "1.0.11",
  "description": "Express server request handler for Remix",
  "main": "index.js",
  "type": "commonjs",
  "types": "types/index.d.ts",
  "scripts": {
    "format": "prettier --write \"**/*.{js,json,ts}\"",
    "test:tsd": "tsd types/",
    "test:node": "node --watch ./test/index.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExorTek/remix-express.git"
  },
  "keywords": [
    "remix",
    "express",
    "handler"
  ],
  "author": "ExorTek - https://github.com/ExorTek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExorTek/remix-express/issues"
  },
  "homepage": "https://github.com/ExorTek/remix-express#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.9.2",
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "printWidth": 120,
    "singleQuote": true
  },
  "dependencies": {
    "@remix-run/node": "^2.16.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "express": "^5.1.0",
    "prettier": "^3.5.3",
    "tsd": "^0.32.0",
    "vite": "^6.3.5"
  },
  "files": [
    "index.js",
    "types"
  ]
}
